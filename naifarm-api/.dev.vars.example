# Sao chép thành `.dev.vars` rồi điền giá trị từ Supabase → Project Settings → API.
# (`.dev.vars` đã nằm trong .gitignore, không commit.)

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Tùy chọn: nếu dự án dùng khoá ký HS256 truyền thống thì điền JWT Secret.
# Nếu bỏ trống, Worker sẽ xác minh JWT qua JWKS công khai của Supabase.
# SUPABASE_JWT_SECRET="<jwt-secret>"

ENVIRONMENT="development"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
